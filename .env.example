NODE_ENV=development
PORT=4000
# Path to the Firebase service account JSON. The default file in the project folder is used when this is empty.
FIREBASE_SERVICE_ACCOUNT=

JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
CLIENT_ORIGIN=http://localhost:5173
BUSINESS_TIMEZONE=Asia/Kolkata
CURRENCY=INR

BOOTSTRAP_EMAIL=superadmin@gyroz.studio
BOOTSTRAP_PASSWORD=Admin@123
BOOTSTRAP_NAME=Super Admin

STORAGE_DRIVER=local
UPLOAD_DIR=uploads
